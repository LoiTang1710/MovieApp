generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model PremiumPlan {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("VND")
  durationDays Int
  isActive     Boolean        @default(true)
  subscriptions Subscription[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  plan      PremiumPlan        @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(PENDING)
  startAt   DateTime?
  endAt     DateTime?
  autoRenew Boolean            @default(false)
  payments  Payment[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
  @@index([status, endAt])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  provider              String
  providerTransactionId String?
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("VND")
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@unique([provider, providerTransactionId])
}
//=================ADMIN=====================
// --- ENUMS ---
enum Role {
  USER
  ADMIN
}

enum ProfileType {
  KID
  ADULT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MovieStatus {
  AVAILABLE
  HIDDEN
}

enum CommentStatus {
  APPROVED
  REJECTED
  DELETED
}

// --- MODELS ---

// UC01 & UC08: Đăng ký, Đăng nhập & Quản lý người dùng
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quan hệ 1-N: Một User có thể có tối đa 5 Profiles (theo mục 3.1.2.a)
  profiles  Profile[]
  @@map("users")
}



// UC02: Quản lý hồ sơ người dùng (Profiles)
model Profile {
  id        String      @id @default(uuid())
  name      String
  avatarUrl String?
  type      ProfileType @default(ADULT)
  
  // Khóa ngoại liên kết với User
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// UC09 & UC03: Quản lý phim & Duyệt phim
model Movie {
  id          String      @id @default(uuid())
  title       String
  description String      @db.Text
  releaseYear Int
  country     String?
  duration    Int?        // Thời lượng tính bằng phút
  posterUrl   String?     // Ảnh bìa
  trailerUrl  String?     // Link trailer
  videoUrl    String?     // Link file video chính
  status      MovieStatus @default(AVAILABLE) // Trạng thái chiếu phim
  views       Int         @default(0)         // Lượt xem (phục vụ UC11 - Thống kê)
  rating      Float       @default(0.0)       // Điểm đánh giá trung bình
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Quan hệ N-N với Thể loại phim
  genres      Genre[]
}

// Hỗ trợ lọc phim theo thể loại (Mục 3.1.3.c)
model Genre {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  movies Movie[]
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model Promotion {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  description     String?
  discountPercent Int
  maxUses         Int?
  usedCount       Int             @default(0)
  status          PromotionStatus @default(ACTIVE)
  startAt         DateTime
  endAt           DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Đánh giá & bình luận theo phim TMDB (tmdbId + mediaType)
model MediaRating {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  mediaType String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tmdbId, mediaType])
  @@index([tmdbId, mediaType])
}

model MediaRatingStats {
  id           String   @id @default(uuid())
  tmdbId       Int
  mediaType    String
  averageStars Float    @default(0)
  totalRatings Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tmdbId, mediaType])
}

model Comment {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId     Int
  mediaType  String
  content    String        @db.Text
  parentId   String?
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("CommentReplies")
  status     CommentStatus @default(APPROVED)
  likeCount  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  likes      CommentLike[]

  @@index([tmdbId, mediaType, createdAt(sort: Desc)])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
}