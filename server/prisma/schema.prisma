generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model PremiumPlan {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("VND")
  durationDays Int
  isActive     Boolean        @default(true)
  subscriptions Subscription[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  plan      PremiumPlan        @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(PENDING)
  startAt   DateTime?
  endAt     DateTime?
  autoRenew Boolean            @default(false)
  payments  Payment[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
  @@index([status, endAt])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  provider              String
  providerTransactionId String?
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("VND")
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@unique([provider, providerTransactionId])
}
//=================ADMIN=====================
// --- ENUMS ---
enum Role {
  USER
  ADMIN
}

enum ProfileType {
  KID
  ADULT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MovieStatus {
  AVAILABLE
  HIDDEN
}

enum CommentStatus {
  APPROVED
  REJECTED
  DELETED
}

// --- MODELS ---

// UC01 & UC08: Đăng ký, Đăng nhập & Quản lý người dùng
model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String?
  fullName    String?
  phone       String?
  dateOfBirth DateTime?
  gender      Gender?
  avatarUrl   String?
  role        Role      @default(USER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Quan hệ 1-N: Một User có thể có tối đa 5 Profiles (theo mục 3.1.2.a)
  profiles     Profile[]
  mediaRatings MediaRating[]
  comments     Comment[]
  commentLikes CommentLike[]
  collections Collection[]
}

// UC02: Quản lý hồ sơ người dùng (Profiles)
model Profile {
  id        String      @id @default(uuid())
  name      String
  avatarUrl String?
  type      ProfileType @default(ADULT)
  
  // Khóa ngoại liên kết với User
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// UC09 & UC03: Quản lý nguồn phát & Trạng thái phim cục bộ (Hybrid với TMDB)
model Movie {
  id          String      @id @default(uuid())
  tmdbId      Int         
  mediaType   String      @default("movie") // "movie" hoặc "tv"
  
  // --- Bộ đệm giao diện (Sẽ tự lấy từ TMDB) ---
  title       String
  posterUrl   String?
  
  // --- Quản trị luồng vận hành ---
  isPremium   Boolean     @default(false)     // Khóa VIP
  status      MovieStatus @default(AVAILABLE) // Ẩn/Hiện phim
  views       Int         @default(0)         // Lượt xem cục bộ
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tmdbId, mediaType]) 
}
// UC11: Bảng Log Lượt xem (Phục vụ vẽ biểu đồ Dashboard)
model ViewLog {
  id        String   @id @default(uuid())
  tmdbId    Int
  mediaType String
  userId    String?  // Có thể null nếu khách chưa đăng nhập xem phim Free
  
  viewedAt  DateTime @default(now()) // Thời điểm xem phim

  // Đánh index để truy vấn biểu đồ theo ngày tháng cực nhanh
  @@index([tmdbId, mediaType])
  @@index([viewedAt]) 
}

// Hỗ trợ lọc phim theo thể loại (Mục 3.1.3.c)


enum PromotionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model Promotion {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  description     String?
  discountPercent Int
  maxUses         Int?
  usedCount       Int             @default(0)
  status          PromotionStatus @default(ACTIVE)
  startAt         DateTime
  endAt           DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Đánh giá & bình luận theo phim TMDB (tmdbId + mediaType)
model MediaRating {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  mediaType String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tmdbId, mediaType])
  @@index([tmdbId, mediaType])
}

model MediaRatingStats {
  id           String   @id @default(uuid())
  tmdbId       Int
  mediaType    String
  averageStars Float    @default(0)
  totalRatings Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tmdbId, mediaType])
}

model Comment {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId     Int
  mediaType  String
  content    String        @db.Text
  parentId   String?
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("CommentReplies")
  status     CommentStatus @default(APPROVED)
  likeCount  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  likes      CommentLike[]

  @@index([tmdbId, mediaType, createdAt(sort: Desc)])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
}

model Collection {
  id Int @id @default(autoincrement())
  userId String
  collectionName String
  iconKey String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  items CollectionItem[]
}
model CollectionItem {
  id Int @id @default(autoincrement())
  collectionId Int
  mediaId Int
  mediaType String
  title String?
  posterPath String?
  rating Float?
  releasedDate String?
  addedAt DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id])
  @@unique([collectionId,mediaId])
}